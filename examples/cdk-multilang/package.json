{
  "name": "@theory-cloud/tabletheory-cdk-multilang-demo",
  "version": "1.1.0-rc.3",
  "license": "Apache-2.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prep": "npm --prefix ../../ts ci && npm --prefix ../../ts run build",
    "synth": "npm run prep && npx -y aws-cdk@2.1128.0 synth",
    "deploy": "npm run prep && npx -y aws-cdk@2.1128.0 deploy --require-approval never",
    "test": "tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1116.0",
    "@aws-sdk/client-kms": "3.1116.0",
    "@aws-sdk/client-s3": "3.1116.0",
    "aws-cdk-lib": "2.266.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  },
  "overrides": {
    "fast-xml-parser": "5.7.3"
  }
}
