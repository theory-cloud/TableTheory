{
  "name": "@theory-cloud/tabletheory-cdk-multilang-demo",
  "version": "1.1.0-rc.3",
  "license": "Apache-2.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prep": "npm --prefix ../../ts ci && npm --prefix ../../ts run build",
    "synth": "npm run prep && npx -y aws-cdk@2.1128.0 synth",
    "deploy": "npm run prep && npx -y aws-cdk@2.1128.0 deploy --require-approval never",
    "test": "tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1053.0",
    "@aws-sdk/client-kms": "3.1053.0",
    "@aws-sdk/client-s3": "3.1053.0",
    "aws-cdk-lib": "2.260.0",
    "constructs": "10.6.0"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "tsx": "4.22.3",
    "typescript": "5.9.3"
  },
  "overrides": {
    "fast-xml-parser": "5.7.3"
  }
}
