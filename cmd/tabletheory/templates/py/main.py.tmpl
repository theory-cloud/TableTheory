from __future__ import annotations

import os
from dataclasses import dataclass

import boto3

from tabletheory_py import ModelDefinition, Table, ensure_table, theorydb_field


# The dataclass + theorydb_field metadata is the TableTheory data contract; the
# same shape is described language-neutrally in dms.yml.
@dataclass(frozen=True)
class Note:
    pk: str = theorydb_field(name="PK", roles=["pk"])
    sk: str = theorydb_field(name="SK", roles=["sk"])
    title: str = theorydb_field(default="")
    value: int = theorydb_field(default=0)
    created_at: str = theorydb_field(name="createdAt", roles=["created_at"], default="")
    updated_at: str = theorydb_field(name="updatedAt", roles=["updated_at"], default="")
    version: int = theorydb_field(roles=["version"], default=0)


def main() -> None:
    client = boto3.client(
        "dynamodb",
        endpoint_url=os.environ.get("DYNAMODB_ENDPOINT", "http://localhost:8000"),
        region_name=os.environ.get("AWS_REGION", "us-east-1"),
        aws_access_key_id=os.environ.get("AWS_ACCESS_KEY_ID", "dummy"),
        aws_secret_access_key=os.environ.get("AWS_SECRET_ACCESS_KEY", "dummy"),
    )

    model = ModelDefinition.from_dataclass(Note, table_name="notes")
    # ensure_table is idempotent — it creates the table if it does not exist.
    ensure_table(model, client=client)
    table = Table(model, client=client)

    table.put(Note(pk="NOTE#1", sk="v1", title="Hello TableTheory", value=42))
    print("created note NOTE#1")

    note = table.get("NOTE#1", "v1")
    print(f"read note: title={note.title!r} value={note.value} version={note.version}")

    table.delete("NOTE#1", "v1")
    print("deleted note NOTE#1")

    print("OK: TableTheory CRUD against DynamoDB Local succeeded")


if __name__ == "__main__":
    main()
