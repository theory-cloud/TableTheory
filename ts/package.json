{
  "name": "@theory-cloud/tabletheory-ts",
  "version": "1.10.1",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/cjs/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./facetheory": {
      "import": {
        "types": "./dist/facetheory-isr.d.ts",
        "default": "./dist/facetheory-isr.js"
      },
      "require": {
        "types": "./dist/cjs/facetheory-isr.d.ts",
        "default": "./dist/cjs/facetheory-isr.js"
      }
    },
    "./release-state": {
      "import": {
        "types": "./dist/release-state.d.ts",
        "default": "./dist/release-state.js"
      },
      "require": {
        "types": "./dist/cjs/release-state.d.ts",
        "default": "./dist/cjs/release-state.js"
      }
    },
    "./lease": {
      "import": {
        "types": "./dist/lease.d.ts",
        "default": "./dist/lease.js"
      },
      "require": {
        "types": "./dist/cjs/lease.d.ts",
        "default": "./dist/cjs/lease.js"
      }
    },
    "./testkit": {
      "import": {
        "types": "./dist/testkit/index.d.ts",
        "default": "./dist/testkit/index.js"
      },
      "require": {
        "types": "./dist/cjs/testkit/index.d.ts",
        "default": "./dist/cjs/testkit/index.js"
      }
    }
  },
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm run test:unit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "tsx test/run-unit.ts",
    "test:integration": "tsx test/run-integration.ts",
    "example:local": "tsx examples/local.ts",
    "build:esm": "tsc -p tsconfig.build.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node -e \"require('node:fs').writeFileSync('dist/cjs/package.json', JSON.stringify({ type: 'commonjs' }) + '\\n')\""
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1092.0",
    "@aws-sdk/client-kms": "^3.1092.0",
    "@aws-sdk/client-sts": "^3.1092.0"
  },
  "overrides": {
    "fast-xml-parser": "5.7.3",
    "flatted": "^3.4.2"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1101.0",
    "@aws-sdk/client-kms": "^3.1101.0",
    "@aws-sdk/client-sts": "^3.1101.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.5",
    "typescript": "^6.0.3"
  }
}
