# Local-only tool installs (do not commit)
.tools/

# Generated evidence (CI artifacts; the verifier regenerates report + logs every
# run, embedding a fresh timestamp and git_head, so none of it is tracked)
evidence/*.log
evidence/gov-rubric-report.json

# Local certification/signature bundles (do not commit)
signatures/

# Optional generated prompt/spec blobs (server-side)
prompts/
